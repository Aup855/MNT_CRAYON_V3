"""
Suite de tests pour la classe CrayonV3 (pastille + jeu + gaine).
Lancer avec : pytest test_crayon_v3.py -v
"""

import numpy as np
import pytest
from crayon_v3 import CrayonV3


def make_crayon(N_f=41, N_c=11, dt=0.02,
                 alpha_f=6.9e-7, k_f=3.0, R_f=4.1e-3,
                 alpha_c=6.94e-6, k_c=15.0, e_gap=8.0e-5, e_clad=5.7e-4,
                 h_gap=1.0e4, h_conv=3.5e4, T_fluide=310.0,
                 T_init=None, source_f=None):
    N_tot = N_f + N_c
    if T_init is None:
        T_init = np.full(N_tot, T_fluide)
    return CrayonV3(
        alpha_f=alpha_f, k_f=k_f, R_f=R_f, N_f=N_f,
        alpha_c=alpha_c, k_c=k_c, e_gap=e_gap, e_clad=e_clad, N_c=N_c,
        h_gap=h_gap, h_conv=h_conv, T_fluide=T_fluide, dt=dt,
        T_init=T_init, source_f=source_f,
    )


def solution_analytique(R_f, k_f, k_c, e_gap, e_clad, h_gap, h_conv,
                         T_fluide, dot_q):
    """Solution stationnaire exacte (parabole pastille + log gaine +
    2 sauts), utilisee comme reference dans plusieurs tests."""
    R_clad = R_f + e_gap + e_clad
    R_gap_moy = R_f + e_gap / 2.0
    B = -dot_q * R_f**2 / (2 * k_c)
    T_clad_out = T_fluide + dot_q * R_f**2 / (2 * h_conv * R_clad)
    A = T_clad_out - B * np.log(R_clad)
    T_clad_in = A + B * np.log(R_f + e_gap)
    T_fuel_surf = T_clad_in + dot_q * R_f**2 / (2 * h_gap * R_gap_moy)
    T_centre = T_fuel_surf + dot_q / (4 * k_f) * R_f**2
    return T_centre, T_fuel_surf, T_clad_in, T_clad_out


# --- Tests herites du solveur de base ---

def test_stabilite_bornee():
    cr = make_crayon(dt=1.0, source_f=3.8e8)
    cr.solve(500)
    assert np.all(np.isfinite(cr.T))
    assert cr.T.max() < 5000.0


def test_isotherme_sans_source():
    """Sans source et tout a T_fluide, rien ne doit bouger."""
    cr = make_crayon(source_f=None, T_fluide=310.0)
    cr.solve(500)
    assert np.allclose(cr.T, 310.0, atol=1e-8)


def test_centre_maximum_et_monotone():
    """Le centre doit etre le point le plus chaud, et la temperature
    doit decroitre (au sens large) du centre vers la surface externe --
    y compris a travers les deux sauts (jeu, film convectif)."""
    cr = make_crayon(source_f=3.8e8)
    cr.solve(20000)
    assert cr.T[0] == cr.T.max()
    assert np.all(np.diff(cr.T) <= 1e-6)


# --- Tests specifiques a la structure multicouche ---

def test_saut_jeu_plus_grand_que_saut_gaine():
    """Physiquement, le jeu (mauvais conducteur, helium) doit produire
    un saut de temperature bien plus grand que la gaine (bon conducteur,
    fine). Attrape une inversion de conductance (jeu et gaine confondus,
    ou aire/dr mal assignes)."""
    cr = make_crayon(source_f=3.8e8)
    cr.solve(20000)

    saut_jeu = cr.T_surface_pastille() - cr.T_interne_gaine()
    saut_gaine = cr.T_interne_gaine() - cr.T_surface_gaine()

    assert saut_jeu > 0
    assert saut_gaine > 0
    assert saut_jeu > saut_gaine


def test_solution_analytique_complete():
    """Test de validation central de la v3 : compare les 4 temperatures
    caracteristiques (centre, surface pastille, interne gaine, surface
    gaine) a la solution analytique exacte (parabole + log + 2 sauts)."""
    N_f, N_c = 81, 21
    alpha_f, k_f, R_f = 6.9e-7, 3.0, 4.1e-3
    alpha_c, k_c = 6.94e-6, 15.0
    e_gap, e_clad = 8.0e-5, 5.7e-4
    h_gap, h_conv = 1.0e4, 3.5e4
    T_fluide, dot_q = 310.0, 3.8e8

    cr = make_crayon(N_f=N_f, N_c=N_c, alpha_f=alpha_f, k_f=k_f, R_f=R_f,
                      alpha_c=alpha_c, k_c=k_c, e_gap=e_gap, e_clad=e_clad,
                      h_gap=h_gap, h_conv=h_conv, T_fluide=T_fluide,
                      source_f=dot_q, dt=0.02)
    cr.solve(20000)

    T_c, T_fs, T_ci, T_co = solution_analytique(
        R_f, k_f, k_c, e_gap, e_clad, h_gap, h_conv, T_fluide, dot_q)

    assert cr.T[0] == pytest.approx(T_c, abs=1e-3)
    assert cr.T_surface_pastille() == pytest.approx(T_fs, abs=1e-3)
    assert cr.T_interne_gaine() == pytest.approx(T_ci, abs=1e-3)
    assert cr.T_surface_gaine() == pytest.approx(T_co, abs=1e-3)


def test_bilan_energie_regime_permanent():
    """La puissance generee dans la pastille seule doit ressortir en
    totalite par convection en surface de la gaine, alors meme que le
    trajet traverse 2 materiaux differents et une interface de contact --
    le test le plus exigeant de la conservation exacte des volumes
    finis, puisqu'il porte sur un systeme heterogene."""
    dot_q = 3.8e8
    R_f = 4.1e-3
    cr = make_crayon(source_f=dot_q)
    cr.solve(20000)

    P_generee = dot_q * np.pi * R_f**2
    P_sortante = cr.flux_sortant_frontiere()

    assert P_sortante == pytest.approx(P_generee, rel=1e-3)


def test_gaine_quasi_isotherme():
    """La gaine (Zircaloy, k eleve, epaisseur faible) doit presenter un
    saut de temperature bien plus petit que la pastille -- typiquement
    quelques dizaines de degres, pas des centaines."""
    cr = make_crayon(source_f=3.8e8)
    cr.solve(20000)
    saut_gaine = cr.T_interne_gaine() - cr.T_surface_gaine()
    assert 0 < saut_gaine < 50.0


def test_conductance_interface_dans_le_tableau_aE():
    """Verifie que l'assemblage a bien insere une seule conductance de
    contact (h_gap * A_gap) a l'indice N_f-1 du tableau aE, entre les
    conductances de conduction de la pastille et de la gaine -- preuve
    que l'architecture "conductance generique" fonctionne comme prevu."""
    N_f, N_c = 41, 11
    cr = make_crayon(N_f=N_f, N_c=N_c, h_gap=1.0e4)

    A_gap_attendu = 2 * np.pi * (cr.R_f + cr.e_gap / 2.0)
    aE_gap_attendu = cr.h_gap * A_gap_attendu

    assert cr.aE[N_f - 1] == pytest.approx(aE_gap_attendu)
    # Les voisins immediats doivent etre des conductances de conduction
    # (donc, dans ce jeu de parametres, tres differentes de aE_gap)
    assert cr.aE[N_f - 2] != pytest.approx(aE_gap_attendu, rel=0.5)
    assert cr.aE[N_f] != pytest.approx(aE_gap_attendu, rel=0.5)


def test_pas_de_singularite_au_centre():
    for N_f in [11, 41, 101]:
        cr = make_crayon(N_f=N_f, source_f=3.8e8)
        cr.solve(200)
        assert np.isfinite(cr.T[0])


@pytest.mark.parametrize("N_f,N_c", [(21, 6), (41, 11), (81, 21)])
def test_stabilite_plusieurs_maillages(N_f, N_c):
    cr = make_crayon(N_f=N_f, N_c=N_c, source_f=3.8e8)
    cr.solve(2000)
    assert np.all(np.isfinite(cr.T))
    assert cr.T[0] >= cr.T[-1] >= cr.T_fluide
